# ==============================================================================
# PROJECT "AETHER-HUMAN" ENVIRONMENT TEMPLATE
# ==============================================================================
APP_NAME=AetherHumanCore
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

GEMINI_API_KEYS=key1,key2,key3
GEMINI_DEFAULT_MODEL=gemini-flash-lite-latest
GEMINI_REASONING_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.85
ENABLE_SLEEP_GHOSTING=false

TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_BOT_TOKEN=your_optional_bot_token
TELEGRAM_PHONE_NUMBER=your_phone_number
TELEGRAM_SESSION_NAME=aether_userbot
TELEGRAM_SESSION_STRING=

POSTGRES_URL=sqlite+aiosqlite:///./aether_human.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aether_secret_pass
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379/0

COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000
ADMIN_SECRET_TOKEN=aether_observatory_master_key_2026
